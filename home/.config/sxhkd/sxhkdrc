#Set environment variables.
# Basic binds
super + Return
	$TERMINAL
super + n
    $FILE
super + d
	rofi -modi drun,window -show drun
super + e
	rofi -modi emoji -show emoji -show-icons -sidebar-mode
super + C
    rofi -modi "clipboard:greenclip print" -show clipboard -run-command '{cmd}'
super + shift + x
    rofi -show p -modi p:'rofi-power-menu'
super + m
    simple-mtpfs --device 1 /mnt/Android -o allow_other & notify-send "Android device mounted"
super + shift + m
    fusermount -u /mnt/Android & notify-send "Android device unmounted"
super + w
	opera

# Et cetera...
super + Scroll_Lock
	killall screenkey || screenkey
super + Insert
	showclip
super + x
    xset dpms force off; /home/mmkumr/.i3/scripts/lock

# Media player controls
# Volume Up with Dunst Notification
XF86AudioRaiseVolume
    bash -c 'curr=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po "[0-9]+(?=%)" | head -1); if [ "$curr" -lt 100 ]; then pactl set-sink-volume @DEFAULT_SINK@ +5%; else pactl set-sink-volume @DEFAULT_SINK@ 100%; fi'

# Volume Down with Dunst Notification
XF86AudioLowerVolume
    bash -c 'curr=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -Po "[0-9]+(?=%)" | head -1); if [ "$curr" -lt 100 ]; then pactl set-sink-volume @DEFAULT_SINK@ -5%; else pactl set-sink-volume @DEFAULT_SINK@ 0%; fi' 

# Brightness Up
XF86MonBrightnessUp
    bash -c 'brightnessctl set +5%; b=$(brightnessctl -m | cut -d, -f4 | tr -d "%"); dunstify -h int:value:$b -r 9993 -u low "Brightness" "$b%"'

# Brightness Down
XF86MonBrightnessDown
    bash -c 'brightnessctl set 5%-; b=$(brightnessctl -m | cut -d, -f4 | tr -d "%"); dunstify -h int:value:$b -r 9993 -u low "Brightness" "$b%"'

XF86AudioPlay 
    playerctl play-pause
XF86AudioPause 
    playerctl pause
XF86AudioNext 
    playerctl next
XF86AudioPrev
    playerctl previous

