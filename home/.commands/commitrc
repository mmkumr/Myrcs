#!/usr/bin/zsh

cd ~/Myrcs || exit 1

# Get a short, machine-readable summary of what changed
changes=$(git status --porcelain)

if [ -n "$changes" ]; then
    # Parse file names out into a clean single line string
    changed_files=$(git status --porcelain | awk '{print $2}' | tr '\n' ',' | sed 's/,$//')
    
    git add .
    git commit -m "Auto-update: $changed_files"
    git push
fi

